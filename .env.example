# Railway private PostgreSQL URL. Configure secrets in Railway or ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set only if apex+www must share cookies (otherwise leave unset for host-only)
# SESSION_COOKIE_DOMAIN=onefinsolution.online
# Opaque database sessions need no JWT/signing secret.
# Signup confirmation and password resets use Resend (preferred) or SMTP.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative; set AI_PROVIDER=xai to enable.
XAI_API_KEY=
XAI_MODEL=grok-4.3
BILLING_PROVIDER=stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Required for custom on-domain Stripe Elements. Test publishable key only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Workspace-only one-time Test Price IDs mapped to {"credits":50,"kind":"pack"}.
STRIPE_CREDIT_PLANS={}
SIGNUP_CREDITS=10
WORKSPACE_CREDIT_COST=1

# Stable random 32+ character secret for keyed visitor identity and trial-card hashes.
# Keep stable across deploys; rotation resets anti-abuse identities.
WORKSPACE_SIGNING_KEY=

# Email - Resend (preferred after domain verification) with SMTP fallback
RESEND_API_KEY=
EMAIL_FROM=One Fin Solution <noreply@onefinsolution.online>
EMAIL_FROM_AUTH=One Fin Solution <auth@onefinsolution.online>
EMAIL_FROM_BILLING=One Fin Solution Billing <billing@onefinsolution.online>
EMAIL_REPLY_TO=support@onefinsolution.online
EMAIL_TEST_TO=
# Optional storefront inquiry recipient override; otherwise EMAIL_REPLY_TO is used.
SOFTWARE_INQUIRY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
