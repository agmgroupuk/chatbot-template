# Railway private PostgreSQL URL. Configure secrets in Railway or ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opaque database sessions need no JWT/signing secret.
# Signup confirmation and password resets require working SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative; set AI_PROVIDER=xai to enable.
XAI_API_KEY=
XAI_MODEL=grok-4.3
BILLING_PROVIDER=stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Optional for future embedded Elements. Hosted Checkout does not need a browser key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Real Test Price IDs mapped to {"credits":100,"kind":"subscription"} or kind "pack".
STRIPE_CREDIT_PLANS={}
SIGNUP_CREDITS=10
CHAT_CREDIT_COST=1
