NEXT_PUBLIC_UPDATE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public canonical origin. Required in production; never use localhost on Railway.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# This release intentionally rejects Live Mode even on Railway production.
NEXT_PUBLIC_UPDATE_ENVIRONMENT=test
# Server only. Configure directly in Railway or an ignored .env.local.
ANTHROPIC_API_KEY=
# Set stripe to use the direct Stripe adapter; update preserves the original provider.
BILLING_PROVIDER=stripe
# Server-only Supabase key for verified billing fulfillment and atomic credit operations.
SUPABASE_SERVICE_ROLE_KEY=
# Test Mode only. Expected account identity is mandatory to prevent cross-project writes.
STRIPE_SECRET_KEY=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# JSON mapping of real Stripe Test price IDs to {"credits":100,"kind":"subscription"} or kind "pack".
# Generated by: node scripts/provision-stripe.mjs --apply
STRIPE_CREDIT_PLANS={}
SIGNUP_CREDITS=10
CHAT_CREDIT_COST=1
