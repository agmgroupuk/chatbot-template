# Connect this separate Railway service to the existing PostgreSQL instance.
# Users and sessions are isolated in the ofs_store schema.
DATABASE_URL="postgresql://..."
DATABASE_POOL_MAX="5"

# Public origin of the standalone software storefront, for password reset links.
SOFTWARE_APP_URL="https://b2b.onefinsolution.online"

# Email is only required for password reset. No verification email is required at signup.
SOFTWARE_RESEND_API_KEY=""
SOFTWARE_EMAIL_FROM="One Fin Software <noreply@b2b.onefinsolution.online>"

# Keep the terms version in sync with the linked main-site policy text.
SOFTWARE_TERMS_VERSION="2026-10"

# Use keys and webhook secrets created for the dedicated B2B Stripe sandbox account.
# The storefront currently rejects live-mode keys; never copy the main site's keys.
SOFTWARE_STRIPE_SECRET_KEY="sk_test_..."
SOFTWARE_STRIPE_WEBHOOK_SECRET="whsec_..."
